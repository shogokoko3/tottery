node_modules/
.DS_Store
.claude/
# 配信用の書き出し先。ビルドで毎回作られる
dist/
# ビルドが assets/audio/ から写す先。元の音源は assets/audio/ のほう
/audio/
# BGM の配布元ファイル。重いので追わない。
# tools/prepare-bgm.mjs の表にある出どころから落とし直せる
assets/audio/原曲/
# tools/bgm-seam.mjs が書き出す試聴用の音
.bgm-seam/

# スキン素材のビルド先。元ファイルは assets/skins/
/skins/

# 盤面画像の配信先。元画像は assets/fields/
/fields/
# iOS のアーカイブと書き出し(tools/ios-release.sh)
ios/build/

# Versioned formation award export
/honors/
.webp-cache/

# 署名のキーチェーンの合言葉(置くなら)。git には入れない
ios/.signing.env

# 漫画画像の配信用コピー（原本は assets/story/comics）
/story-comics/

# 漫画の元画像(PNG)と見本の絵。重いので git には入れず Mac に残す(2026-10-22)
assets/story/ouhiroi-*/
assets/cards/redesign-*/
# iCloud の競合コピー(「skins 8」「config 2.xml」など)
* [0-9]
* [0-9][0-9]
* [0-9].*
* [0-9][0-9].*
