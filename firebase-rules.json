{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{4,8}$/)",

        "guestPresent": { ".validate": "newData.isBoolean()" },

        "acts": {
          "$actId": {
            ".validate": "newData.hasChild('type') && newData.child('type').isString() && newData.child('type').val().length <= 40"
          }
        }
      }
    },

    "lobby": {
      ".read": true,

      "$code": {
        ".write": true,
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{4,8}$/)",

        "host": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "guest": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
